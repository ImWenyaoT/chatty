{
  "name": "chatty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "setup": "pnpm install",
    "dev": "next dev -p 3000",
    "dev:api": "node --watch src/server/main.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint src tests components lib app && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "node src/evals/lib/runner.ts",
    "eval:retrieval": "node src/evals/lib/runner.ts retrieval",
    "eval:agent": "node src/evals/lib/runner.ts agent",
    "smoke:browser": "node scripts/smoke-browser.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@astryxdesign/cli": "^0.7.17",
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@stylexjs/stylex": "^0.19.2",
    "ai": "^7.0.181",
    "hono": "^4.13.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agent-browser": "^0.44.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3"
  }
}
