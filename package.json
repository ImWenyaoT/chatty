{
  "name": "chatty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "pnpm build && node src/server/main.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "node src/evals/lib/runner.ts",
    "eval:retrieval": "node src/evals/lib/runner.ts retrieval",
    "eval:agent": "node src/evals/lib/runner.ts agent",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@openai/agents": "^0.14.2",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "hono": "^4.13.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4"
  }
}
