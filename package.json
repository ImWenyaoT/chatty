{
  "name": "chatty",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @chatty/api dev",
    "dev:web": "pnpm --filter @chatty/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @chatty/api start",
    "test": "pnpm --filter @chatty/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && prettier --check \"{apps,docs}/**/*.{ts,tsx,css,md,json}\" \"*.{json,yaml,md}\"",
    "format": "prettier --write .",
    "eval:retrieval": "pnpm --filter @chatty/api eval:retrieval",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "prettier": "^3.9.0"
  }
}
