{
  "name": "chatty",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @chatty/server dev",
    "dev:web": "pnpm --filter @chatty/frontend dev",
    "build": "pnpm --filter @chatty/frontend build",
    "start": "pnpm build && pnpm --filter @chatty/server start",
    "test": "pnpm --filter @chatty/server test",
    "typecheck": "pnpm --filter @chatty/frontend typecheck && pnpm --filter @chatty/server typecheck",
    "lint": "pnpm lint:frontend && pnpm lint:server && pnpm format:check",
    "lint:frontend": "pnpm --filter @chatty/frontend lint",
    "lint:server": "pnpm --filter @chatty/server lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:retrieval": "pnpm --filter @chatty/server eval:retrieval",
    "eval:agent": "pnpm --filter @chatty/server eval:agent",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6"
  }
}
