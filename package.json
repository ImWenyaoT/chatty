{
  "name": "chatty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "setup": "pnpm install",
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm --dir web dev\"",
    "dev:api": "node --watch src/server/main.ts",
    "dev:web": "pnpm --dir web dev",
    "build": "pnpm --dir web build && node scripts/copy-web-dist.ts",
    "start": "pnpm build && node src/server/main.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit --pretty false && pnpm --dir web typecheck",
    "lint": "oxlint src tests && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "node src/evals/lib/runner.ts",
    "eval:retrieval": "node src/evals/lib/runner.ts retrieval",
    "eval:agent": "node src/evals/lib/runner.ts agent",
    "smoke:browser": "node scripts/smoke-browser.ts",
    "check": "pnpm typecheck && pnpm test && pnpm --dir web build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "ai": "^7.0.181",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "agent-browser": "^0.44.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
