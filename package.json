{
  "name": "chatty",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @chatty/api dev",
    "dev:web": "pnpm --filter @chatty/web dev",
    "build": "pnpm --filter @chatty/web build",
    "start": "pnpm build && pnpm --filter @chatty/api start",
    "test": "pnpm --filter @chatty/api test",
    "typecheck": "pnpm --filter @chatty/web typecheck && pnpm --filter @chatty/api typecheck",
    "lint": "pnpm lint:web && pnpm lint:api && pnpm format:check",
    "lint:web": "pnpm --filter @chatty/web lint",
    "lint:api": "pnpm --filter @chatty/api lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:retrieval": "pnpm --filter @chatty/api eval:retrieval",
    "eval:agent": "pnpm --filter @chatty/api eval:agent",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6"
  }
}
