DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional compatibility fallback. When DEEPSEEK_API_KEY is absent, Chatty can
# reuse this key with the configured base URL.
# OPENAI_API_KEY=your_compatible_key

# Local only: logs observable context including profile and recent behavior.
# CHATTY_AGENT_DEBUG=1
