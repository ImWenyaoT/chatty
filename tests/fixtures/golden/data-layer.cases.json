{
  "comment": "跨语言 parity 基线的输入定义。Python 与 TypeScript 后端读同一份 case，输出必须逐字节匹配 data-layer.expected.json。只允许只读操作，不得包含写库行为。",
  "cases": [
    {
      "name": "中文逐字加空格，ASCII 词不拆开",
      "op": "segment_for_index",
      "input": { "text": "降噪 iPhone 15" }
    },
    {
      "name": "空文本不产生索引词",
      "op": "segment_for_index",
      "input": { "text": "" }
    },
    {
      "name": "短文本不切块",
      "op": "split_into_chunks",
      "input": { "text": "只有一句。", "target": 160, "overlap": 40 }
    },
    {
      "name": "按中文句末切块",
      "op": "split_into_chunks",
      "input": { "text": "第一句。第二句。第三句。", "target": 8, "overlap": 0 }
    },
    {
      "name": "切块保留重叠上下文",
      "op": "split_into_chunks",
      "input": {
        "text": "配送时效说明。默认使用合作快递发货。偏远地区可能延长。节假日顺延。",
        "target": 16,
        "overlap": 6
      }
    },
    {
      "name": "同义词改写补充规范词",
      "op": "rewrite_query",
      "input": { "query": "想要安静一点的，挤地铁用" }
    },
    {
      "name": "已含规范词时不重复补充",
      "op": "rewrite_query",
      "input": { "query": "降噪 静音 耳机" }
    },
    {
      "name": "无同义词命中时原样返回",
      "op": "rewrite_query",
      "input": { "query": "降噪耳机通勤" }
    },
    {
      "name": "中文查询按字切分为 FTS 表达式",
      "op": "match_expression",
      "input": { "query": "退换货" }
    },
    {
      "name": "中英混合查询的 FTS 表达式",
      "op": "match_expression",
      "input": { "query": "iPhone 手机 256G" }
    },
    {
      "name": "FTS 表达式最多取八个词",
      "op": "match_expression",
      "input": { "query": "a b c d e f g h i j" }
    },

    {
