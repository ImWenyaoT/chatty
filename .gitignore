# ============================================================
# 运行时产物
# ============================================================
.venv/
__pycache__/
*.py[cod]
*.so

# data/ 下的 JSON、JSONL 是可读种子，要进版本库；
# 由种子生成的 SQLite 库是派生产物，不进。
.local/
*.db
*.db-wal
*.db-shm
*.sqlite*

# ============================================================
# 工具缓存
# ============================================================
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty/
.coverage
coverage/
htmlcov/
build/
dist/
*.egg-info/

# ============================================================
# 密钥与本地配置
# ============================================================
# .env 存 API key，绝不能提交；.env.example 是模板，必须提交。
.env
.env.*
!.env.example

# ============================================================
# 编辑器与 AI 助手
# ============================================================
.vscode/
.idea/
*.code-workspace
.DS_Store
# Claude Code 的本地状态默认不进仓库，**只放行 skills**：
# clone 到新机器就能直接用，不必先去别处装一遍。settings.local.json、worktree
# 这些是这台机器的状态，仍然挡在外面。
# 注意 `.claude/*` 而不是 `.claude/`——后者会连同子目录一起排除，`!` 放行不回来。
.claude/*
!.claude/skills/
.remember/

# ============================================================
# 本地私有材料
# ============================================================
# 求职文档只留在本地，不属于这个项目。
docs/jd.md
docs/*实习.pdf
*.log

# 前端 workspace
node_modules/
frontend/node_modules/
frontend/dist/
