{
  "name": "@chatty/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "eval:retrieval": "tsc -p tsconfig.json && node dist/src/retrieval-eval.js"
  },
  "dependencies": {
    "@openai/agents": "^0.14.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "openai": "^6.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}
